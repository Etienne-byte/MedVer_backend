# Copy this file to .env and fill in your Firebase project values.
FIREBASE_URL=https://distance-prediction-system-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=distance-prediction-system
FIREBASE_CRED=serviceAccountKey.json

# Optional scanner defaults
SERIAL_PORT=MOCK
LOCATION=Kigali
DEVICE_ID=edge-scanner-01
DEFAULT_SIMILARITY=95
