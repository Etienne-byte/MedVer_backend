# Copy this file to .env and fill in your Firebase project values.
FIREBASE_URL=https://medver-62f1f-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=medver-62f1f
FIREBASE_CRED=serviceAccountKey.json
FIREBASE_WEB_API_KEY=

# Comma-separated Firebase Authentication emails assigned to each MedVerify role.
# These are bootstrap accounts; user creation and role assignment are managed by the backend.
ROLE_ADMIN_EMAILS=
ROLE_FIELD_OFFICER_EMAILS=
ROLE_ICT_STAFF_EMAILS=
ROLE_MANAGER_EMAILS=

# Optional scanner defaults
SERIAL_PORT=MOCK
LOCATION=Kigali
DEVICE_ID=edge-scanner-01
DEFAULT_SIMILARITY=95
